// GGX-prefilters an environment cube into the specular reflection one: mip 0 is a mirror and
// the last mip is fully rough, so the scene pass reads a roughness by choosing a level.
//
// This is the first half of Karis' split sum. The second half - how much of what is reflected
// actually leaves the surface - has no dependence on the environment at all and lives in the
// preintegrated BRDF table instead.

#include "PBR_PrecomputeCommon.fxh"

cbuffer IblBakeConstants
{
    /// The face being rendered, as the axes its texels span.
    float4 g_FaceRight;
    float4 g_FaceUp;
    float4 g_FaceForward;
    /// x is the perceptual roughness the mip being filled stands for; y the source cube's face
    /// size in texels and z its mip count; w how many directions to sample.
    float4 g_Filter;
};

TextureCube  g_Environment;
SamplerState g_Environment_sampler;

struct PSInput
{
    float4 Position     : SV_POSITION;
    float2 NormalizedXY : NORMALIZED_XY;
};

struct PSOutput
{
    float4 Color : SV_TARGET;
};

void main(in PSInput PSIn, out PSOutput PSOut)
{
    float2 span = NormalizedDeviceXYToTexUV(PSIn.NormalizedXY) * 2.0 - 1.0;
    float3 reflected = normalize(g_FaceForward.xyz + g_FaceRight.xyz * span.x + g_FaceUp.xyz * span.y);

    // The normal and the view are both taken to be the direction this texel stands for. That
    // is the approximation the split sum rests on, and it is what lets one cube serve every
    // viewing angle - at the price of the stretched highlight a grazing view should show.
    float3 normal = reflected;
    float3 view = reflected;

    float roughness = g_Filter.x;
    float alphaRoughness = roughness * roughness;
    uint sampleCount = uint(g_Filter.w);
    float texelSolidAngle = ComputeCubeMapPixelSolidAngle(g_Filter.y, g_Filter.y);

    float3 filtered = float3(0.0, 0.0, 0.0);
    float totalWeight = 0.0;
    for (uint i = 0u; i < sampleCount; ++i)
    {
        float3 halfway = ImportanceSampleGGX(Hammersley2D(i, sampleCount), roughness, normal);
        float3 toLight = 2.0 * dot(view, halfway) * halfway - view;
        float nDotL = saturate(dot(normal, toLight));
        float vDotH = saturate(dot(view, halfway));
        if (nDotL > 0.0 && vDotH > 0.0)
        {
            float probability = max(SmithGGXSampleDirectionPDF(view, normal, toLight, alphaRoughness), 1e-4);
            float sampleSolidAngle = 1.0 / (float(sampleCount) * probability);
            // A mirror has no lobe to spread over, so it reads the source at full resolution.
            float mip = alphaRoughness == 0.0
                      ? 0.0
                      : clamp(0.5 * log2(sampleSolidAngle / max(texelSolidAngle, 1e-10)) + 1.0, 0.0, g_Filter.z - 1.0);
            // Weighted by nDotL and divided by the same sum below, which is the empirical
            // correction the split sum needs to hold up against a constant environment.
            filtered += g_Environment.SampleLevel(g_Environment_sampler, toLight, mip).rgb * nDotL;
            totalWeight += nDotL;
        }
    }

    PSOut.Color = float4(filtered / max(totalWeight, 1e-4), 1.0);
}
